# TourGuide / Tourfy — variables de entorno.
#
# Copiar a .env.local y completar. Los valores de aca son placeholders, no
# secretos reales. Todo lo que NO empieza con NEXT_PUBLIC_ es server-only y no
# puede terminar en el bundle del browser.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en API Routes / server actions. Bypassa RLS: nunca en NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Meta / WhatsApp Cloud API
# ---------------------------------------------------------------------------
META_APP_ID=
# Valida la firma X-Hub-Signature-256 del webhook y el token exchange.
META_APP_SECRET=
# Token de verificacion inicial del webhook (GET /api/webhooks/whatsapp).
META_WEBHOOK_VERIFY_TOKEN=
# Modelo B: UN System User token permanente opera los numeros de todos los
# tenants. Es la UNICA fuente del token de mensajeria (lib/whatsapp/token.ts) —
# sin esto el bot no puede responder.
META_SYSTEM_USER_TOKEN=
# PIN para registrar numeros (two-step verification). Opcional: sin el, el
# register es best-effort y se saltea.
META_DEFAULT_WABA_PIN=
# Override del host de Graph API. Opcional, default v21.0 de graph.facebook.com.
META_GRAPH_API_BASE=
# Embedded Signup (se leen en el cliente, van con NEXT_PUBLIC_ a proposito).
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# ---------------------------------------------------------------------------
# N8N (motor del bot)
# ---------------------------------------------------------------------------
N8N_WEBHOOK_URL=
# Header X-Webhook-Secret al llamar al webhook de N8N (evita invocacion anonima).
N8N_WEBHOOK_SECRET=
# Bearer que N8N manda de vuelta a /api/internal/*. Sin esto las rutas internas
# devuelven 500 (fail closed a proposito).
N8N_INTERNAL_SECRET=
# Base URL que se le pasa a N8N para el callback.
TOURGUIDE_API_URL=

# ---------------------------------------------------------------------------
# OpenAI (Whisper para audio, vision para imagenes, extractor del onboarding)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis)
# ---------------------------------------------------------------------------
# OJO: si faltan, el rate limiter queda DESHABILITADO en silencio — es fail-open
# por diseno (lib/ratelimit.ts). En prod hay que setearlas de verdad.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Cron (Vercel)
# ---------------------------------------------------------------------------
# Auth del cron de limpieza de media.
CRON_SECRET=
# Heartbeat de BetterStack para el cron. Opcional, solo prod.
BETTERSTACK_HEARTBEAT_CLEANUP_MEDIA=
# Heartbeat del backup diario de la DB. OJO: es un secret de GitHub Actions
# (.github/workflows/db-backup.yml), NO va en Vercel.
BETTERSTACK_HEARTBEAT_DB_BACKUP=

# ---------------------------------------------------------------------------
# Sentry
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Solo en build, para subir source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Varios
# ---------------------------------------------------------------------------
# Base absoluta para sitemap.xml y robots.txt.
NEXT_PUBLIC_SITE_URL=
# debug | info | warn | error. Default: info en prod, debug en dev.
LOG_LEVEL=
