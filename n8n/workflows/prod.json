    {
      "parameters": {
        "toolDescription": "Recogidas en hotel. Úsala cuando el cliente pregunte a qué hora lo recogen, si recogen en su hotel o en qué hoteles recogen. Tour y hotel pueden ir vacíos. Sigue el campo \"instruction\" de la respuesta.",
        "method": "POST",
        "url": "={{ $('Code in JavaScript').first().json.callback_base_url + '/api/internal/pickups' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Code in JavaScript').first().json.n8n_secret }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({                                      \n    conversation_id: $('Code in JavaScript').first().json.conversation_id,\n    tour: $fromAI('tour', 'Nombre del tour; vacío si el cliente no lo dijo', 'string'),\n    hotel: $fromAI('hotel', 'Hotel o zona donde se hospeda el cliente; vacío si no lo dijo', 'string') }) }}",
        "options": {}
      },
      "id": "e1536ce1-dd06-4ae7-a6ee-3d748dd49a00",
      "name": "get_pickup_times",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        960,
        688
      ]
    },
    {
      "parameters": {
        "jsCode": "const reply = String($input.first().json.output ?? '').trim();\nconst client = String($('Code in JavaScript').first().json.allMessages ?? '');\n\n// Respaldo en el idioma del cliente\nconst en = (client.match(/\\b(the|and|you|we|is|are|would|can|have|for|with|thanks)\\b/gi) || []).length >= 2;\nconst FALLBACK = en\n  ? \"Thanks for your message! I'm passing your request to someone on our team and they'll get back to you shortly.\"\n  : 'Gracias por escribirnos. Le paso tu consulta a alguien del equipo y te responde en breve.';\n\n// Razonamiento interno que se filtra (visto en prod: \"We must follow developer instructions...\")\nconst LEAK = /(developer (message|instructions?)|system (message|prompt)|tool call|transfer_to_human|get_pickup_times|the user (wants|asked|is)|final answer|we must (follow|respond)|I should (respond|reply))/i;\n\nlet text = reply\n  .replace(/\\s*[—–]\\s*/g, ', ')\n  .replace(/\\s*;\\s*/g, '. ')\n  .replace(/(\\p{L})\\/(\\p{L})/gu, en ? '$1 or $2' : '$1 o $2')\n  .replace(/ {2,}/g, ' ')\n  .trim();\n\nconst blocked = !text || text.length > 1500 || LEAK.test(text);\nif (blocked) text = FALLBACK;\n\nreturn [{ json: { output: text, blocked, raw: reply } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        400
      ],
      "id": "f2587dc4-81a0-43cb-8099-639acbb0b925",
      "name": "Sanitize Reply"
